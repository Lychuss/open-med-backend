generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR

  @@map("user_roles")
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role    
  sex           Sex
  age           Int
  city          String  
  patient       Patients?
  doctor        Doctors?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Patients {
  id        String    @id @default(cuid())
  userId    String    @unique
  concern   Expertise[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient")
}

model Doctors {
  id            String     @id @default(cuid())
  userId        String     @unique
  years         Int        @default(0)
  school        String
  hospital      String
  online        Boolean
  lastOnline    DateTime
  education     String 
  expertise     Expertise[]
  user          User        @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@map("doctor")
}

model Expertise {
  id          String     @id
  name        String     @unique
  description String?

  patient     Patients[] 
  doctor      Doctors[]

  @@map("expertise")
}

