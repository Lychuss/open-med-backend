generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR

  @@map("user_roles")
}

enum Sex {
  MALE
  FEMALE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(PATIENT)
  sex           Sex       
  age           Int
  city          String  
  patient       Patients?
  doctorApplication        DoctorsApplication?
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]


  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Patients {
  id        String    @id @default(cuid())
  userId    String    @unique
  concern   Expertise[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient")
}

model Expertise {
  id          String     @id
  name        String     @unique
  description String?

  patient     Patients[] 
  doctorApplication      DoctorsApplication[]

  @@map("expertise")
}

model RateLimit {
  id          String    @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model DoctorsApplication {
  id            String             @id @default(cuid())
  userId        String             @unique
  licenseNumber String             @unique
  licenseExpiry DateTime
  school        String
  hospital      String
  education     String? 
  expertise     Expertise[]
  status        VerificationStatus @default(PENDING)
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctors_application")
}